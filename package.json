{
  "name": "glowlab",
  "version": "1.0.0",
  "description": "GlowLab — AI-powered personal skincare assistant (desktop, offline)",
  "main": "./out/main/index.js",
  "author": "Bakhriddinov Alisher",
  "homepage": "https://github.com/Alisherbakh",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "test": "vitest run --project unit",
    "test:db": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --project db",
    "test:e2e": "electron-vite build && playwright test",
    "test:watch": "vitest --project unit",
    "seed:demo": "ELECTRON_RUN_AS_NODE=1 electron --no-warnings scripts/seed-demo.ts",
    "fetch:models": "node scripts/fetch-embedding-model.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@google/genai": "^3.0.0",
    "@huggingface/tokenizers": "0.2.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "better-sqlite3": "^13.0.3",
    "onnxruntime-node": "^1.31.1",
    "sqlite-vec": "0.1.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "productName": "GlowLab",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
